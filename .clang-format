# clang-format configuration for socketlink-client-server-code
# Tuned to match the existing style of the sources in src/.
---
Language: Cpp
BasedOnStyle: LLVM

# Indentation (matches existing 4-space style)
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
NamespaceIndentation: All

# Line length: existing code has long lines; 120 is the enforced ceiling
ColumnLimit: 120

# Braces: attached (K&R), as the file already uses
BreakBeforeBraces: Attach

# Pointers/references: keep whatever side the existing code uses per-file
DerivePointerAlignment: true
PointerAlignment: Left

# NEVER reorder includes — App.h must come first and header order is load-bearing
SortIncludes: Never

# Lambdas and short constructs (uWS handler style)
AllowShortLambdasOnASingleLine: All
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Misc
# AlwaysBreak (not Align): break after every '(' that wraps, so wrapped calls
# indent uniformly by ContinuationIndentWidth instead of aligning to the '('
# column. Align made the route chain (.get/.post/.put/.del) indent by the
# method-name length and pick per-call whether to inline the first argument, so
# sibling handlers drifted by a space. AlwaysBreak keeps them identical.
AlignAfterOpenBracket: AlwaysBreak
BinPackArguments: true
BinPackParameters: true
BreakConstructorInitializers: BeforeColon
IndentCaseLabels: true
KeepEmptyLinesAtTheStartOfBlocks: true
MaxEmptyLinesToKeep: 2
ReflowComments: false
SpacesBeforeTrailingComments: 1
